# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StrataFlow
NODE_ENV=development

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/strataflow?schema=public"
# For connection pooling in production (e.g. PgBouncer / Supabase pooler):
# DATABASE_URL="postgresql://postgres:password@localhost:6543/strataflow?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/strataflow?schema=public"

# ─── NextAuth ────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Email (Magic Link) — uses Nodemailer
EMAIL_FROM="StrataFlow <noreply@strataflow.app>"
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-user
EMAIL_SERVER_PASSWORD=your-smtp-password

# ─── Redis (BullMQ / sessions) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Storage ─────────────────────────────────────────────────────────────────
# "local"  → filesystem adapter (default in development, files in .uploads/)
# "s3"     → S3-compatible adapter (default in production)
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=s3
S3_BUCKET=strataflow-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Provider-specific overrides (all optional)
# AWS S3:         leave S3_ENDPOINT unset
# Cloudflare R2:  S3_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# Backblaze B2:   S3_ENDPOINT=https://s3.<region>.backblazeb2.com  +  S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Optional CDN prefix for public documents (e.g. CloudFront, Cloudflare)
# When set, presignDownload returns "${S3_PUBLIC_URL}/${key}" instead of a signed URL
S3_PUBLIC_URL=

# ─── Security ────────────────────────────────────────────────────────────────
# Max file upload size in bytes (default 20 MB)
MAX_FILE_SIZE=20971520
# Comma-separated allowed MIME types for document uploads
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Signing secret used to verify inbound payment webhook payloads
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret
